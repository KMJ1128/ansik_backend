# Copy this file to .env.properties on the VM. Never commit the copied file.
# Cloud SQL must authorize only the VM public IP (34.50.8.4/32).
DB_URL=jdbc:mysql://34.64.134.240:3306/ansik_db?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=ansik_app
DB_PASSWORD=replace-with-the-ansik-app-password

SERVER_PORT=8088
DB_POOL_MAX_SIZE=5
JPA_SHOW_SQL=false

OPENAI_API_KEY=replace-me
KAKAO_REST_API_KEY=replace-me
NAVER_SEARCH_CLIENT_ID=replace-me
NAVER_SEARCH_CLIENT_SECRET=replace-me
TOUR_API_KEY=replace-me
GOOGLE_PLACES_API_KEY=replace-me

KAKAO_LOGIN_NATIVE_APP_KEY=replace-me
NAVER_LOGIN_CLIENT_ID=replace-me
NAVER_LOGIN_CLIENT_SECRET=replace-me
GOOGLE_LOGIN_WEB_CLIENT_ID=replace-me
AUTH_JWT_SECRET_BASE64=replace-with-at-least-32-random-bytes-in-base64
